parameters:
	ignoreErrors:
		-
			message: '#^Offset int\<min, 2\>\|int\<4, max\> might not exist on array\{''RSA'', ''DSA'', ''DH'', ''EC''\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: src/Signer/Ecdsa.php

		-
			message: '#^Call to static method Lcobucci\\JWT\\Signer\\Key\\InMemory\:\:guardAgainstEmptyKey\(\) with non\-empty\-string will always evaluate to true\.$#'
			identifier: staticMethod.alreadyNarrowedType
			count: 2
			path: src/Signer/Key/InMemory.php

		-
			message: '#^Offset int\<min, \-1\>\|int\<1, max\> might not exist on array\{''RSA'', ''DSA'', ''DH'', ''EC''\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: src/Signer/Rsa.php

		-
			message: '#^@readonly property Lcobucci\\JWT\\Token\\Builder\:\:\$claims is assigned outside of the constructor\.$#'
			identifier: property.readOnlyByPhpDocAssignNotInConstructor
			count: 1
			path: src/Token/Builder.php

		-
			message: '#^@readonly property Lcobucci\\JWT\\Token\\Builder\:\:\$headers is assigned outside of the constructor\.$#'
			identifier: property.readOnlyByPhpDocAssignNotInConstructor
			count: 1
			path: src/Token/Builder.php

		-
			message: '#^@readonly property cannot have a default value\.$#'
			identifier: property.readOnlyByPhpDocDefaultValue
			count: 2
			path: src/Token/Builder.php

		-
			message: '''
				#^Call to deprecated method __construct\(\) of class Lcobucci\\JWT\\Token\\Builder\:
				Deprecated since v5\.5, please use \{@see self\:\:new\(\)\} instead$#
			'''
			identifier: method.deprecated
			count: 1
			path: src/Token/Builder.php

		-
			message: '#^Impure property assignment in pure method Lcobucci\\JWT\\Token\\Builder\:\:withHeader\(\)\.$#'
			identifier: impure.propertyAssign
			count: 1
			path: src/Token/Builder.php

		-
			message: '#^Possibly impure call to method Lcobucci\\JWT\\Token\\Builder\:\:setClaim\(\) in pure method Lcobucci\\JWT\\Token\\Builder\:\:canOnlyBeUsedAfter\(\)\.$#'
			identifier: possiblyImpure.methodCall
			count: 1
			path: src/Token/Builder.php

		-
			message: '#^Possibly impure call to method Lcobucci\\JWT\\Token\\Builder\:\:setClaim\(\) in pure method Lcobucci\\JWT\\Token\\Builder\:\:expiresAt\(\)\.$#'
			identifier: possiblyImpure.methodCall
			count: 1
			path: src/Token/Builder.php

		-
			message: '#^Possibly impure call to method Lcobucci\\JWT\\Token\\Builder\:\:setClaim\(\) in pure method Lcobucci\\JWT\\Token\\Builder\:\:identifiedBy\(\)\.$#'
			identifier: possiblyImpure.methodCall
			count: 1
			path: src/Token/Builder.php

		-
			message: '#^Possibly impure call to method Lcobucci\\JWT\\Token\\Builder\:\:setClaim\(\) in pure method Lcobucci\\JWT\\Token\\Builder\:\:issuedAt\(\)\.$#'
			identifier: possiblyImpure.methodCall
			count: 1
			path: src/Token/Builder.php

		-
			message: '#^Possibly impure call to method Lcobucci\\JWT\\Token\\Builder\:\:setClaim\(\) in pure method Lcobucci\\JWT\\Token\\Builder\:\:issuedBy\(\)\.$#'
			identifier: possiblyImpure.methodCall
			count: 1
			path: src/Token/Builder.php

		-
			message: '#^Possibly impure call to method Lcobucci\\JWT\\Token\\Builder\:\:setClaim\(\) in pure method Lcobucci\\JWT\\Token\\Builder\:\:permittedFor\(\)\.$#'
			identifier: possiblyImpure.methodCall
			count: 1
			path: src/Token/Builder.php

		-
			message: '#^Possibly impure call to method Lcobucci\\JWT\\Token\\Builder\:\:setClaim\(\) in pure method Lcobucci\\JWT\\Token\\Builder\:\:relatedTo\(\)\.$#'
			identifier: possiblyImpure.methodCall
			count: 1
			path: src/Token/Builder.php

		-
			message: '#^Possibly impure call to method Lcobucci\\JWT\\Token\\Builder\:\:setClaim\(\) in pure method Lcobucci\\JWT\\Token\\Builder\:\:withClaim\(\)\.$#'
			identifier: possiblyImpure.methodCall
			count: 1
			path: src/Token/Builder.php

		-
			message: '#^Possibly impure call to method Lcobucci\\JWT\\Token\\RegisteredClaimGiven\:\:forClaim\(\) in pure method Lcobucci\\JWT\\Token\\Builder\:\:withClaim\(\)\.$#'
			identifier: possiblyImpure.methodCall
			count: 1
			path: src/Token/Builder.php
